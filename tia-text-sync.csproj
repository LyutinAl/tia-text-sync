<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>tia_text_sync</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=False: сборки загружаются из установки TIA Portal (см. Core/OpennessResolver.cs) -->
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>.\libs\V21\net48\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>.\libs\V21\net48\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
